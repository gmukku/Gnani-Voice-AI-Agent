      "model_ptp_date": "",
      "expected_stage_code": "BUSY",
      "ptp_offset_days": null
    },
    {
      "id": "C05-rnr",
      "scenario": "Answered but silent",
      "utterance": "",
      "model_disposition": "RNR",
      "model_ptp_date": "",
      "expected_stage_code": "RNR",
      "ptp_offset_days": null
    },
    {
