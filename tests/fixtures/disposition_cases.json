      "expected_stage_code": "NO_LOAN",
      "ptp_offset_days": null
    },
    {
      "id": "C07-rtp-medical",
      "scenario": "Medical hardship",
      "utterance": "I have been in hospital, I cannot manage it",
      "model_disposition": "RTP_MEDICAL",
      "model_ptp_date": "",
      "expected_stage_code": "RTP_MEDICAL",
      "ptp_offset_days": null
