# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Application ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# MUST match the Time Zone set on the Gnani agent, or "today"/"tomorrow" in a
# conversation resolves to a different date here than the bot intended.
# Mountain (MST) = America/Denver | Eastern = America/New_York
TIMEZONE=America/New_York

# Public URL Gnani uses to reach this service. Gnani cannot reach localhost,
# so in local development this is your tunnel (ngrok / cloudflared) origin.
PUBLIC_BASE_URL=https://your-tunnel-id.ngrok-free.app

# --- Gnani Agents Console ------------------------------------------------
# Base URL of the Agents Console API.
# Point at the local mock (http://localhost:9100) to run the full loop
# without console access -- see tests/mock_gnani/.
GNANI_BASE_URL=http://localhost:9100
GNANI_API_KEY=
GNANI_AGENT_ID=

# Docker only. Inside a container, 127.0.0.1 is the container itself, so the
# value above cannot be reused -- docker-compose reads this separate variable
# instead and defaults to the mock service name. Set it to https://api.inya.ai
# to run the containerised app against the real platform.
# GNANI_BASE_URL_DOCKER=http://mock-gnani:9100

# The outbound call-trigger path is not documented publicly; kept configurable
# so the real endpoint can be swapped in without a code change.
GNANI_TRIGGER_PATH=/api/v1/calls/trigger
GNANI_TIMEOUT_SECONDS=10
GNANI_MAX_RETRIES=3

# --- Gnani speech APIs (api.vachana.ai) ----------------------------------
# Separate product surface from the Agents Console, with per-scope keys issued
# at app.gnani.ai/voice -> API Keys. Header is X-API-Key-ID (not Bearer).
# Used for supplementary Prisma/Timbre evidence, not for placing calls.
VACHANA_BASE_URL=https://api.vachana.ai
GNANI_STT_API_KEY=
GNANI_TTS_API_KEY=

# --- Security -------------------------------------------------------------
# Shared secret Gnani must send as X-Webhook-Key on the post-call webhook.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_API_KEY=

# --- Storage --------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=emi_voice_agent

# --- Business defaults ----------------------------------------------------
DEFAULT_LANGUAGE=en-US
# INR renders as "rupees" / "rupias" in the spoken disclosure line; USD, EUR
# and GBP are also mapped. Never let the ISO code reach TTS -- it gets spelled
# out letter by letter ("I N R").
CURRENCY=INR
LENDER_NAME=ICICI Bank
MAX_PTP_DAYS_AHEAD=90
